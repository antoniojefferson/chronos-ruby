{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chronos.example/schemas/apm-batch-v1.schema.json",
  "title": "Chronos APM metric batch payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["metrics", "dropped_groups"],
  "properties": {
    "dropped_groups": {"type": "integer", "minimum": 0},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["metric_type", "dimensions", "count", "error_count", "error_rate", "duration_ms", "histogram", "breakdown_ms", "signals", "status_codes"],
        "properties": {
          "metric_type": {"enum": ["request", "query", "job", "external_http"]},
          "dimensions": {"type": "object"},
          "count": {"type": "integer", "minimum": 1},
          "error_count": {"type": "integer", "minimum": 0},
          "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "duration_ms": {
            "type": "object",
            "required": ["total", "min", "max", "average"]
          },
          "percentiles_ms": {
            "type": "object",
            "additionalProperties": false,
            "required": ["p50", "p95", "p99"],
            "properties": {
              "p50": {"type": "number", "minimum": 0},
              "p95": {"type": "number", "minimum": 0},
              "p99": {"type": "number", "minimum": 0}
            }
          },
          "histogram": {"type": "array", "maxItems": 20},
          "breakdown_ms": {"type": "object"},
          "signals": {"type": "object"},
          "status_codes": {"type": "object"},
          "severity_counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "error": {"type": "integer", "minimum": 0},
              "warning": {"type": "integer", "minimum": 0},
              "info": {"type": "integer", "minimum": 0},
              "suggestion": {"type": "integer", "minimum": 0}
            }
          },
          "diagnostics": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "severity", "category", "message", "evidence", "count"],
              "properties": {
                "code": {"type": "string", "maxLength": 128},
                "severity": {"enum": ["error", "warning", "info", "suggestion"]},
                "category": {"type": "string", "maxLength": 64},
                "message": {"type": "string", "maxLength": 512},
                "recommendation": {"type": "string", "maxLength": 512},
                "evidence": {"type": "object"},
                "count": {"type": "integer", "minimum": 1}
              }
            }
          },
          "query_analysis": {"type": "object"},
          "tracking": {
            "type": "object",
            "additionalProperties": false,
            "required": ["active_traces", "dropped_trace_trackers", "expired_trace_trackers", "dropped_query_fingerprints"],
            "properties": {
              "active_traces": {"type": "integer", "minimum": 0},
              "dropped_trace_trackers": {"type": "integer", "minimum": 0},
              "expired_trace_trackers": {"type": "integer", "minimum": 0},
              "dropped_query_fingerprints": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
