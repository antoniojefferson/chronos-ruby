#!/usr/bin/env sh
set -eu
artifact_dir=$(mktemp -d)
trap 'rm -rf "$artifact_dir"' EXIT
# Stage only packaged files. RubyGems bundled with Ruby 2.2 has no --output option.
ruby -rrubygems/package -rfileutils -e '
  spec = Gem::Specification.load("chronos-ruby.gemspec")
  stage = File.join(ARGV.fetch(0), "source")
  FileUtils.mkdir_p(stage)
  spec.files.each do |path|
    target = File.join(stage, path)
    FileUtils.mkdir_p(File.dirname(target))
    FileUtils.cp(path, target)
  end
  Dir.chdir(stage) do
    built = Gem::Package.build(spec)
    File.rename(built, File.join(ARGV.fetch(0), "chronos.gem"))
  end
' "$artifact_dir"
gem install --local "$artifact_dir/chronos.gem" --install-dir "$artifact_dir/gems" --no-document
GEM_HOME="$artifact_dir/gems" GEM_PATH="$artifact_dir/gems" "$artifact_dir/gems/bin/chronos" --help
CHRONOS_PROJECT_ID=package-test CHRONOS_PROJECT_KEY=not-a-real-key \
CHRONOS_ENVIRONMENT=package-test CHRONOS_DEPLOY_ID=package-test CHRONOS_DEPLOY_REVISION=package-test \
GEM_HOME="$artifact_dir/gems" GEM_PATH="$artifact_dir/gems" "$artifact_dir/gems/bin/chronos" deploy diagnose --offline

customer_root="$artifact_dir/customer with spaces"
mkdir "$customer_root"
GEM_HOME="$artifact_dir/gems" GEM_PATH="$artifact_dir/gems" "$artifact_dir/gems/bin/chronos" \
  deploy install --provider kamal --root "$customer_root"
GEM_HOME="$artifact_dir/gems" GEM_PATH="$artifact_dir/gems" "$artifact_dir/gems/bin/chronos" \
  deploy install --provider kamal --root "$customer_root" --check
test -x "$customer_root/.kamal/hooks/post-deploy"

GEM_HOME="$artifact_dir/gems" GEM_PATH="$artifact_dir/gems:$(ruby -e 'puts Gem.path.join(":")')" \
CHRONOS_TEST_EXECUTABLE="$artifact_dir/gems/bin/chronos" ruby test/deploy_transport_test.rb
