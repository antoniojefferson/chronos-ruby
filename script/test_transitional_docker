#!/usr/bin/env sh
set -eu
version=${1:-3.3}
example=${2:-}
case "$version" in
  2.7|3.0|3.1|3.2|3.3|3.4) ;;
  *) echo "Use Ruby 2.7, 3.0, 3.1, 3.2, 3.3 or 3.4." >&2; exit 1 ;;
esac
case "$version:$example" in
  *:|*:examples/sidekiq-7) ;;
  2.7:examples/rails-7.0|3.0:examples/rails-7.0) ;;
  2.7:examples/rails-7.1|3.1:examples/rails-7.1|3.2:examples/rails-7.1) ;;
  3.1:examples/rails-7.2|3.3:examples/rails-7.2|3.4:examples/rails-7.2) ;;
  *) echo "Use a documented transitional framework/Ruby pair." >&2; exit 1 ;;
esac
project_root=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
docker run --rm --platform linux/amd64 \
  --volume "$project_root:/src:ro" --env EXAMPLE_PATH="$example" \
  --env BUNDLE_IGNORE_CONFIG=1 --env BUNDLE_PATH=/tmp/chronos-bundle \
  "ruby:$version" sh -eu -c '
    mkdir /work
    tar -C /src --exclude=.git --exclude=.bundle --exclude=.aws --exclude=.codex --exclude=.agents --exclude=".env*" \
      --exclude=vendor --exclude=tmp --exclude=log --exclude="*.gem" --exclude="*.lock" -cf - . | tar -C /work -xf -
    cd /work
    ruby -v
    if [ -n "$EXAMPLE_PATH" ]; then
      sh script/ci_transitional_integration
    else
      sh script/ci_transitional
    fi
  '
