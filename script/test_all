#!/usr/bin/env bash
set -euo pipefail

tested=0
versions="${CHRONOS_RUBIES:-2.7.8 3.0.7 3.1.6 3.2.7 3.3.5 3.4.3}"
for version in $versions; do
  if rbenv versions --bare | grep -x "$version" >/dev/null; then
    echo "Testing Ruby $version"
    RBENV_VERSION="$version" bundle exec rake
    tested=$((tested + 1))
  else
    echo "Skipping Ruby $version because it is not installed"
  fi
done

if [ "$tested" -eq 0 ]; then
  echo "No supported Ruby version was tested" >&2
  exit 1
fi
