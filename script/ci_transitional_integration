#!/usr/bin/env sh
set -eu
: "${EXAMPLE_PATH:?EXAMPLE_PATH is required}"
case "$EXAMPLE_PATH" in
  examples/rails-7.0|examples/rails-7.1|examples/rails-7.2|examples/sidekiq-7) ;;
  *) echo "Unsupported transitional fixture" >&2; exit 1 ;;
esac
export BUNDLE_GEMFILE="$EXAMPLE_PATH/Gemfile"
gem list --installed bundler -v 2.4.22 >/dev/null || gem install bundler -v 2.4.22 --no-document
bundle _2.4.22_ install
if [ "$EXAMPLE_PATH" = examples/sidekiq-7 ]; then
  bundle _2.4.22_ exec ruby -Ilib examples/sidekiq-7/smoke.rb
else
  bundle _2.4.22_ exec ruby -Ilib examples/rails-transitional/smoke.rb
fi
